# ─── Solana / MagicBlock ───────────────────────────────────────────────
# Base layer (Solana devnet via MagicBlock RPC)
SOLANA_RPC_ENDPOINT=https://rpc.magicblock.app/devnet
# Router for delegation status (returns the ER fqdn per account)
ROUTER_ENDPOINT=https://devnet-router.magicblock.app/
# Ephemeral rollup endpoint (set from router getDelegationStatus.fqdn; placeholder below)
EPHEMERAL_PROVIDER_ENDPOINT=https://devnet-as.magicblock.app/

# Deployed program id (devnet)
VEILAI_PROGRAM_ID=86unmnYc6pGfmmCwFLBjbiVT9pd3vJA5CaAzyreYewPT

# Devnet USDC mint
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Private Payments API (P1 — private payout leg)
PAYMENTS_API_BASE=https://payments.magicblock.app

# ─── Wallets / keypairs (never commit real keys) ───────────────────────
# Path to the deploy/authority keypair json
ANCHOR_WALLET=./wallets/deployer.keypair.json
# Provider agent keypair
PROVIDER_KEYPAIR=./wallets/provider.keypair.json

# ─── Stub enclave (MVP) ────────────────────────────────────────────────
# ed25519 secret (base58) standing in for the TEE quoting key
ENCLAVE_QUOTING_SECRET=
# Fixed measurement (hex) registered as the agent's allowlisted MRTD
ENCLAVE_MEASUREMENT=

# ─── Model provider (inference inside the stub enclave) ─────────────────
ANTHROPIC_API_KEY=

# ─── Backend ───────────────────────────────────────────────────────────
BACKEND_PORT=4000

# ─── Supabase (server-side; service role key must NEVER reach the client) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Privy (custom login UI — email, Google, X)
NEXT_PUBLIC_PRIVY_APP_ID=
# Supabase client (browser — anon key + url only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
