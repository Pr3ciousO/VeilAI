{
  "name": "veilai",
  "version": "0.1.0",
  "private": true,
  "description": "Private, verifiable execution infrastructure for AI agents.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm -r test",
    "anchor:build": "cd anchor && anchor build",
    "anchor:test": "cd anchor && anchor test",
    "anchor:deploy": "cd anchor && anchor deploy"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
